{
  "name": "dyslexia-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Reading Disorders & Color Blindness Simulation: an interactive, accessible demo of how dyslexia, Irlen Syndrome, other reading disorders, and colour vision deficiency change what people see. A modern TypeScript fork of Victor Widell's 2016 demo.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dyslexia",
    "irlen-syndrome",
    "reading-disorders",
    "accessibility",
    "a11y",
    "typoglycemia",
    "simulation",
    "empathy",
    "color-blindness",
    "colour-vision-deficiency"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "predev": "node scripts/vendor-mathjax.mjs",
    "prebuild": "node scripts/vendor-mathjax.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "mathjax2": "npm:mathjax@2.7.7",
    "mathjax4": "npm:mathjax@4.1.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
